# =========================================================
# MANSA — .gitignore (Unreal Engine 5 + Laravel + outils)
# =========================================================

# ---------- Unreal Engine (projet dans /Mansa) ----------
# Fichiers générés : recréés à la compilation / à l'ouverture de l'éditeur
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/Windows/
Build/Receipts/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.suo
*.sln
*.slnx
*.xcodeproj
*.xcworkspace
.vsconfig.bak

# On garde les icônes et réglages de build éventuels
!Build/**/*.ico

# Plugins : on garde le code et le contenu, pas les binaires générés
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Dossiers personnels de test dans l'éditeur
Content/Developers/

# ---------- IDE ----------
.vs/
.vscode/
.idea/
*.code-workspace
Mansa/.vsconfig.user

# ---------- Laravel (/backend) ----------
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/pail/
backend/.phpunit.cache/
backend/.phpunit.result.cache
# SECRETS : la clé API Claude ne doit JAMAIS être commitée
backend/.env
backend/.env.backup
backend/.env.production
backend/auth.json
.env
!.env.example
!backend/.env.example

# ---------- Blender (/tools/blender et sources d'art) ----------
*.blend1
*.blend2
__pycache__/
*.pyc

# ---------- FMOD (/audio) ----------
audio/**/.cache/
audio/**/.user/
audio/**/Build/
audio/**/*.lock

# ---------- Substance Painter ----------
*.spp.autosave
*.spp.bak

# ---------- Système ----------
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.log
